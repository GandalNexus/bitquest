# Variables d'environnement pour BitQuest

# Base de données PostgreSQL (Docker)
DATABASE_URL="postgresql://bitquest:bitquest_dev_password@localhost:5432/bitquest"

# Redis pour rate-limit distribué (optionnel : fallback in-memory si vide)
REDIS_URL="redis://localhost:6379"

# Secret pour la génération des tokens CSRF (obligatoire en production)
# CSRF_SECRET="change-me-in-production"

# Environnement
NODE_ENV="development"
