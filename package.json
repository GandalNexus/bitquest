{
  "name": "bitquest",
  "version": "0.4.0",
  "private": true,
  "description": "BitQuest — gamified educational platform for learning Bitcoin and the Lightning Network (GandalNexus).",
  "license": "AGPL-3.0",
  "author": "GandalNexus",
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "oxlint --config oxlint.json src/ && eslint .",
    "lint:eslint": "eslint .",
    "lint:oxc": "oxlint --config oxlint.json src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:api": "playwright test tests/e2e/auth.spec.ts tests/e2e/challenge.spec.ts tests/e2e/health.spec.ts tests/e2e/admin-gate.spec.ts tests/e2e/quest-flow.spec.ts tests/e2e/certificate-flow.spec.ts tests/e2e/discoverability.spec.ts tests/e2e/admin-security.spec.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seed.ts",
    "db:backup": "bash scripts/backup-postgres.sh",
    "db:restore": "bash scripts/restore-postgres.sh"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
