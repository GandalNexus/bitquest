# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# Auto-généré par `next dev` à chaque démarrage (voir node_modules/next/dist/server/lib/generate-agent-files.js)
AGENTS.md

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Whitelist : templates sans secrets, versionnés pour que les opérateurs
# aient un point de départ (à remplir avec `openssl rand -hex 32`).
!.env.example
!.env.prod.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
/test
/prompt

server.log
# Skills directory
/skills/

# Snapshots locaux de la base SQLite (ne jamais versionner)
# Note : depuis Phase 0.4, la base principale est Postgres (bitquest_postgres_data).
# Les fichiers SQLite ci-dessous sont conservés pour l'historique mais ne sont
# plus utilisés par l'app en dev.
/db/*.bak*
/db/*.db-journal
/db/*.sqlite*

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/

# Postgres backups (scripts/backup-postgres.sh, voir docs/POSTGRES_PROD.md)
/backups/
*.dump.gz
.vitest/

# Admin image uploads — servis depuis public/uploads/ en runtime, à monter
# sur volume dédié en prod. Seul .gitkeep est versionné (dir doit exister
# pour que l'endpoint POST /api/admin/uploads/image ait où écrire).
public/uploads/*
!public/uploads/.gitkeep
