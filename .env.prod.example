# .env.prod.example — fill, copy to `.env.prod`, add `.env.prod` to .gitignore.
#
# Generate every secret with : openssl rand -hex 32
# All 5 BIT*_SECRET / CSRF_SECRET / CERTIFICATE_SIGN_SECRET must be at
# least 32 chars and distinct ; the env validator refuses `placeholder`,
# `change-me`, or substrings of each other.
#
# Usage :
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d

# --- Postgres ------------------------------------------------------------

# Postgres superuser is only used by the container for the init step.
# The app connects as POSTGRES_APP_USER (created manually — see
# docs/POSTGRES_PROD_HARDENING.md §3).
POSTGRES_SUPERUSER=bitquest_dba
POSTGRES_SUPERUSER_PASSWORD=__GENERATE__
POSTGRES_DB=bitquest

# Non-superuser role the app authenticates with at runtime.
POSTGRES_APP_USER=bitquest_app
POSTGRES_APP_PASSWORD=__GENERATE__

# --- Redis ---------------------------------------------------------------

REDIS_PASSWORD=__GENERATE__

# --- Application secrets -------------------------------------------------

CSRF_SECRET=__GENERATE__
BITLAB_JWT_SECRET=__GENERATE__
BITLAB_LAUNCH_SECRET=__GENERATE__
BITLAB_SIGN_SECRET=__GENERATE__
CERTIFICATE_SIGN_SECRET=__GENERATE__

# --- CORS + public URLs --------------------------------------------------

# Exact origins separated by commas. No wildcards, no localhost in prod.
BITLAB_ALLOWED_ORIGINS=https://www.bitlab.gandalnexus.xyz

# URLs exposed to the browser bundle (compiled into the Next.js client).
NEXT_PUBLIC_BITLAB_URL=https://www.bitlab.gandalnexus.xyz
NEXT_PUBLIC_BITQUEST_HOST=https://www.bitquest.gandalnexus.xyz

# --- Image reference -----------------------------------------------------

# Override if you host the image on a private registry.
# BITQUEST_IMAGE=registry.example.com/bitquest:v0.4.0

# --- Observability (optional) --------------------------------------------

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Backup --------------------------------------------------------------

# Number of daily dumps retained in ./backups/ by the backup service.
BACKUP_RETENTION=14
