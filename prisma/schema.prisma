generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  pseudo          String   @unique
  email           String?  @unique
  passwordHash    String?
  isGuest         Boolean  @default(false)
  isBot           Boolean  @default(false)
  role            String   @default("APPRENTICE") // APPRENTICE | EDITOR | ADMIN
  token           String   @unique
  xp              Int      @default(0)
  sats            Int      @default(0)
  satsEarnedTotal Int      @default(0)
  streak          Int      @default(1)
  lastActiveDate  String?
  createdAt       DateTime @default(now())
  deletedAt       DateTime? // soft-delete RGPD : row conservée pour l'audit, PII effacées à la suppression

  progress       UserQuestProgress[]
  badges         UserBadge[]
  transactions   WalletTransaction[]
  events         UserEvent[]
  lessonProgress LessonProgress[]
  adminAuditLogs AdminAuditLog[]
  dailyChallengeCompletions DailyChallengeCompletion[]
  bitLabProofs BitLabProof[]
}

model Quest {
  id             String @id @default(cuid())
  code           String @unique
  track          String // INITIATION | INTERMEDIATE | ADVANCED | SPECIAL
  order          Int
  title          String
  subtitle       String
  description    String
  intro          String
  theorySections String // JSON: [{ title, body, keypoints: [] }]
  xpReward       Int
  satsReward     Int
  requiredLevel  Int    @default(1)
  missionType    String
  missionConfig  String // JSON config for the BitLab mission generator

  quizQuestions QuizQuestion[]
  progress      UserQuestProgress[]
  chapters      ChapterQuest[]
}

model QuizQuestion {
  id          String @id @default(cuid())
  questId     String
  quest       Quest   @relation(fields: [questId], references: [id], onDelete: Cascade)
  order       Int
  type        String // MCQ | TRUE_FALSE
  question    String
  options     String // JSON array of options (empty for TRUE_FALSE)
  correct     String // JSON: { index } for MCQ, { bool } for TRUE_FALSE
  explanation String
}

model UserQuestProgress {
  id              String    @id @default(cuid())
  userId          String
  questId         String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest           Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)
  status          String    @default("AVAILABLE") // IN_PROGRESS | THEORY_DONE | QUIZ_PASSED | COMPLETED
  sectionsRead    Int       @default(0)
  quizBestScore   Int       @default(0) // percent
  quizAttempts    Int       @default(0)
  perfectQuiz     Boolean   @default(false)
  missionSession  String? // JSON server-side session: { challenge, expected }
  missionAttempts Int       @default(0)
  missionProof    String? // JSON proof data from BitLab
  xpEarned        Int       @default(0)
  satsEarned      Int       @default(0)
  completedAt     DateTime?

  @@unique([userId, questId])
}

model Badge {
  id             String @id @default(cuid())
  code           String @unique
  name           String
  description    String
  icon           String // lucide icon name
  rarity         String // COMMON | RARE | EPIC
  conditionType  String // QUEST_COMPLETE | QUEST_COUNT | TRACK_COMPLETE | STREAK | LEVEL | SATS_TOTAL | PERFECT_QUIZ
  conditionValue String // JSON payload for condition
  users          UserBadge[]
}

model UserBadge {
  userId   String
  badgeId  String
  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt DateTime @default(now())

  @@id([userId, badgeId])
}

model WalletTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int // positive = gain
  type        String // QUEST_REWARD | STREAK_BONUS | DAILY_CAP
  description String
  createdAt   DateTime @default(now())
}

model UserEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // QUEST_COMPLETED | BADGE_UNLOCKED | LEVEL_UP | SATS_EARNED | QUIZ_PASSED | LESSON_COMPLETED
  payload   String // JSON
  createdAt DateTime @default(now())
}

/* =============================================================
 * ACADEMY  — Sprint 1B
 * Parcours pédagogique structuré (Course → Chapter → Lesson),
 * complémentaire du système de quêtes gamifiées.
 * ============================================================= */

model Course {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  subtitle    String
  description String
  coverIcon   String    @default("BookOpen")
  order       Int
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  chapters Chapter[]
}

model Chapter {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  slug     String
  title    String
  summary  String
  order    Int

  lessons      Lesson[]
  linkedQuests ChapterQuest[]

  @@unique([courseId, slug])
  @@index([courseId, order])
}

model Lesson {
  id               String    @id @default(cuid())
  chapterId        String
  chapter          Chapter   @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  slug             String
  title            String
  summary          String
  content          String
  estimatedMinutes Int       @default(5)
  order            Int
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  progress LessonProgress[]

  @@unique([chapterId, slug])
  @@index([chapterId, order])
}

model LessonProgress {
  userId      String
  lessonId    String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@id([userId, lessonId])
  @@index([userId])
}

model ChapterQuest {
  chapterId String
  questId   String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  quest     Quest   @relation(fields: [questId], references: [id], onDelete: Restrict)
  order     Int
  note      String?

  @@id([chapterId, questId])
  @@index([chapterId])
}

/* =============================================================
 * ADMIN AUDIT LOG — Phase 2.3+
 * Trace toutes les mutations admin (role change, CRUD contenu, etc.)
 * ============================================================= */

model AdminAuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action    String   // ROLE_CHANGE | COURSE_CREATE | COURSE_UPDATE | COURSE_DELETE | CHAPTER_* | LESSON_*
  resource  String   // ex. "course:cmwb...", "lesson:cmw9..."
  meta      String   // JSON snapshot (changements, contexte)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

/* =============================================================
 * DAILY CHALLENGE — Phase 2.8
 * Un défi par jour-calendrier. Pas de création/completion automatique,
 * c'est un apport pédagogique léger qui vit à côté des quêtes.
 * ============================================================= */

model DailyChallenge {
  id         String   @id @default(cuid())
  date       String   @unique // ISO day "YYYY-MM-DD" — timezone UTC
  title      String
  prompt     String   // description courte
  xpReward   Int      @default(10)
  satsReward Int      @default(50)
  createdAt  DateTime @default(now())

  completions DailyChallengeCompletion[]
}

model DailyChallengeCompletion {
  userId      String
  challengeId String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  completedAt DateTime       @default(now())

  @@id([userId, challengeId])
  @@index([userId])
}

/* =============================================================
 * BITLAB INTEGRATION — Phase 3 foundation
 * Preuves cryptographiques de mission réelle (txid testnet4, invoice BOLT11).
 * Pour l'instant, aucun Quest n'est câblé sur ce modèle — c'est une fondation
 * à activer quête par quête dans un sprint ultérieur.
 * ============================================================= */

model BitLabProof {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questCode  String // code de la quête concernée (pas FK — on garde la preuve même si la quête est supprimée)
  kind       String // TX | BLOCK | INVOICE | CHANNEL | ADDRESS
  network    String // testnet4 | signet | regtest
  payload    String // JSON { txid, blockHash, bolt11, … }
  verifiedAt DateTime @default(now())
  consumed   Boolean  @default(false) // true quand la preuve a déjà donné lieu à l'octroi de récompense

  @@unique([userId, questCode, kind])
  @@index([userId])
  @@index([questCode])
}
